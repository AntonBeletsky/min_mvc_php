{
    "name": "min-php/mvc",
    "description": "Минимальный MVC-фреймворк на PHP",
    "type": "project",
    "require": {
        "php": "^8.3",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/container": "^2.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "MinMvc\\": "src/",
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
